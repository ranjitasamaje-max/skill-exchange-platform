# Copy these variable names into backend/.env and provide local values.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-random-secret-of-at-least-32-bytes>
PORT=5000
# Optional comma-separated browser origins for additional trusted frontend hosts.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
